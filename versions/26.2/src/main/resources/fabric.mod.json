{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",

  "name": "${name}",
  "description": "Adds some helpful enchantments for Shulker Boxes (MC 26.2 port - WORK IN PROGRESS, core gameplay not yet ported, see the port-26.2 branch commit message and Mod.kt)",
  "authors": [
    "RubixDev"
  ],
  "contact": {
    "homepage": "https://github.com/RubixDev/EnchantedShulkers",
    "sources": "https://github.com/RubixDev/EnchantedShulkers",
    "issues": "https://github.com/RubixDev/EnchantedShulkers/issues"
  },

  "license": "GPL-3.0-only",

  "environment": "*",
  "entrypoints": {
    "main": [{
      "value": "de.rubixdev.enchantedshulkers.Mod",
      "adapter": "kotlin"
    }]
  },
  "accessWidener": "${id}.accesswidener",

  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "26.2",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}"
  }
}
